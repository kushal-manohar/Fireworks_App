{
  "expo": {
    "name": "Satyamamba Fireworks POS",
    "slug": "fireworks-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fireworks-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/fireworks-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.satyamamba.fireworkspos",
      "versionCode": 1,
      "splash": {
        "image": "./assets/fireworks-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/fireworks-icon.png",
        "backgroundImage": "./assets/fireworks-icon.png",
        "monochromeImage": "./assets/fireworks-icon.png"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Fireworks POS to access camera for scanning barcodes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/fireworks-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "90ab80f5-5099-47f6-b786-2ae7cab8345e"
      }
    }
  }
}
